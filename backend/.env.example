# Copie para .env e ajuste os valores
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pizzaria?schema=public"

# Gere um segredo forte, ex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-este-segredo"
JWT_EXPIRES_IN="30d"

PORT=3333

# Origens liberadas no CORS / Socket.IO (separadas por vírgula). "*" libera tudo.
CORS_ORIGIN="http://localhost:3000"

# Cloudinary (upload de imagem de produto). Crie uma conta grátis em
# cloudinary.com e copie essas 3 chaves do dashboard. Sem elas, a API sobe
# normalmente — só o upload de produto fica indisponível.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
